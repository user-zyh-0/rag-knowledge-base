# ============================================
# 这是 .env 的"样板间"—— 只放结构，不放真 Key
# 用法：别人 clone 你的项目后，复制这份为 .env，填上自己的 Key 就能跑
# 本文件会被提交到 git（因为它不含任何密钥）
# ============================================

# ---------- API Keys ----------
# DeepSeek 官方（LLM：负责"写答案"）
# 申请页：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-在这里填你自己的DeepSeekKey

# 硅基流动（Embedding：负责"找资料"）
# 申请页：https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=sk-在这里填你自己的硅基流动Key


# ---------- base_url ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1


# ---------- 模型名 ----------
LLM_MODEL=deepseek-flash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024


# ---------- 阶段一参数（阶段四会回来调这几个数做对比实验）----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
